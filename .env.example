# -----------------------------------------------------------------------------
# MARTE-thesis-worktree environment template (no secrets)
# Copy to .env and fill as needed.
# -----------------------------------------------------------------------------

# Generic LLM
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEY_ENV=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_SEED=
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_S=5
# Conservative shared cadence for myLab's 15 requests/minute limit.
LLM_MIN_INTERVAL_S=4.2

# Optional provider-specific keys
OPENAI_API_KEY=
MYLAB_API_KEY=
ANTHROPIC_API_KEY=

# Attack role
ATTACK_LLM_PROVIDER=
ATTACK_LLM_BASE_URL=
ATTACK_LLM_API_KEY=
ATTACK_LLM_API_KEY_ENV=
ATTACK_LLM_MODEL=glm-4.7
ATTACK_LLM_TEMPERATURE=
# Recommended experiment cap; includes hidden reasoning tokens where applicable.
ATTACK_LLM_MAX_TOKENS=700
ATTACK_LLM_SEED=
ATTACK_LLM_TIMEOUT_S=
ATTACK_LLM_MAX_RETRIES=3
ATTACK_LLM_RETRY_BACKOFF_S=5
ATTACK_LLM_MIN_INTERVAL_S=4.2

# Judge role (shares the attack backend unless a separate backend is configured)
JUDGE_LLM_MODEL=glm-4.7
JUDGE_LLM_TEMPERATURE=
JUDGE_LLM_MAX_TOKENS=768
JUDGE_LLM_SEED=

# Target role
TARGET_LLM_PROVIDER=
TARGET_LLM_BASE_URL=
TARGET_LLM_API_KEY=
TARGET_LLM_API_KEY_ENV=
TARGET_LLM_MODEL=gpt-oss-120b
TARGET_LLM_TEMPERATURE=
# Recommended experiment cap; gpt-oss reasoning tokens count toward this budget.
TARGET_LLM_MAX_TOKENS=4096
TARGET_LLM_SEED=
TARGET_LLM_TIMEOUT_S=
TARGET_LLM_MAX_RETRIES=3
TARGET_LLM_RETRY_BACKOFF_S=5
TARGET_LLM_MIN_INTERVAL_S=4.2

# CLI / Experiment
RUN_REAL_LLM_TESTS=
MARTE_RESULTS_DB=
# Technical LLM failures are retried inside the same logical step and phase.
# Six attempts prevent a long provider outage from hanging the experiment.
# Set 0 only when unlimited transient retries are explicitly desired.
MARTE_STEP_MAX_ATTEMPTS=6
MARTE_STEP_RETRY_BACKOFF_S=5
MARTE_STEP_RETRY_MAX_BACKOFF_S=60
MARTE_RAG_COLLECTION=
# Technical calibration only: disables mandatory similarity thresholds in API mode.
MARTE_RAG_DIAGNOSTIC_MODE=
MARTE_RAG_POSITIVE_TOP_K=3
MARTE_RAG_BLOCKED_TOP_K=1
MARTE_RAG_POSITIVE_FETCH_K=12
MARTE_RAG_BLOCKED_FETCH_K=4
# Frozen by retrieval calibration version rag-thresholds-v1-2026-06-13.
MARTE_RAG_POSITIVE_MIN_SIMILARITY=0.5676532241107325
MARTE_RAG_BLOCKED_MIN_SIMILARITY=0.6303290619675757
MARTE_CHROMA_PATH=
